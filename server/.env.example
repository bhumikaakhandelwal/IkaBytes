# Copy this file to .env and fill in real values
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/skillmatch for local)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillmatch

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# --- Groq AI (resume analysis + suggestions) ---
# Get a free key at https://console.groq.com/keys  (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Max Groq calls per student per day (cached results don't count)
AI_DAILY_LIMIT_PER_STUDENT=5

# Optional: URL of the Python/FastAPI ranking service. Leave empty to use the built-in scorer.
# The service must expose POST {AI_SERVICE_URL}/rank — see src/services/matching.js
AI_SERVICE_URL=
